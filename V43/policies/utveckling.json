{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListaBucketen",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::BUCKETNAMN"
    },
    {
      "Sid": "LasaAllaFiler",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::BUCKETNAMN/*"
    },
    {
      "Sid": "LaddaUppUtkast",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::BUCKETNAMN/utkast/*"
    }
  ]
}

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LasaUtkast",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::BUCKETNAMN/utkast/*"
    },
    {
      "Sid": "SkrivaPublicerat",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::BUCKETNAMN/publicerat/*"
    }
  ]
}

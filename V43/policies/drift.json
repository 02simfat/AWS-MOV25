{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SeServrar",
      "Effect": "Allow",
      "Action": "ec2:Describe*",
      "Resource": "*"
    },
    {
      "Sid": "StyraNovatrixServrar",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:RebootInstances"
      ],
      "Resource": "arn:aws:ec2:REGION:KONTO_ID:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "Novatrix"
        }
      }
    },
    {
      "Sid": "LanaPubliceraRollen",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::KONTO_ID:role/novatrix-publicera"
    }
  ]
}
